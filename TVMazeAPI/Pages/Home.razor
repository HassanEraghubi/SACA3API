@page "/"
@inject TvMazeService TvMaze

<EditForm Model="searchInput" OnValidSubmit="SearchAsync" class="mb-4">
    <DataAnnotationsValidator />

    <div class="input-group">
        <InputText type="search" class="form-control" placeholder="Search for a TV show..." @bind-Value="searchInput.Query" />
        <button type="submit" class="btn btn-primary" disabled="@isSearching">Search</button>
    </div>
    <ValidationMessage For="() => searchInput.Query" />
</EditForm>

@if (searchResults != null || isSearching || searchError != null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Search Results</h1>
        <button type="button" class="btn btn-outline-secondary" @onclick="ClearSearch">Clear</button>
    </div>

    @if (searchError != null)
    {
        <div class="alert alert-danger">@searchError</div>
    }
    else if (isSearching)
    {
        <p>Searching...</p>
    }
    else if (searchResults!.Count == 0)
    {
        <p>No shows found for "@lastQuery".</p>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var result in searchResults)
            {
                <div class="col">
                    <ShowCard Show="result.Show" Subtitle="@ShowLabel(result.Show)" />
                </div>
            }
        </div>
    }
}
else
{
    


    <h1>Airing Today</h1>

    @if (errorMessage != null)
    {
        <div class ="alert alert-danger">
            @errorMessage
        </div>
        
    }
    else if (schedule == null)
    {
        <p>Loading...</p>
    }
    else if (schedule.Count == 0)
    {
        <p>Nothing airing today.</p>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-4 g-3">
            
            @foreach (var item in schedule)
            {
                <div class="col">
                    <ShowCard Show="item.Show" Subtitle="@EpisodeLabel(item)" />
                </div>
            }
        </div>
    }
}

@code{
    private List<ScheduleItem>? schedule;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            schedule = await TvMaze.GetScheduleAsync();
        }
        catch
        {
            errorMessage = "Couldn't load today's schedule";
        }
    }

    private static string EpisodeLabel(ScheduleItem item) =>
        $"S{item.Season} E{item.Number} – {item.Name}";


    private SearchInput searchInput = new();
    private List<SearchResult>? searchResults;
    bool isSearching;
    private string? searchError;
    private string lastQuery = "";
    private async Task SearchAsync()
    {
        searchError = null;
        isSearching = true;
        lastQuery = searchInput.Query;
        try
        {
            searchResults = await TvMaze.SearchShowsAsync(searchInput.Query);
        }
        catch
        {
            searchError = "Couldn't Search, please try again";
        }
        finally
        {
            isSearching = false;
        }
    }

    private void ClearSearch()
    {
        searchResults = null;
        searchError = null;
        searchInput = new();
    }

    private static string ShowLabel(Show show)
    {
        var genres = show.Genres.Count > 0 ? string.Join(",", show.Genres) : "No Genres";
        var year = show.Premiered?.Year.ToString() ?? "Unknown year";

        return $"{genres} . {year} ";
    }


    




}