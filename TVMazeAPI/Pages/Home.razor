@page "/"
@inject TvMazeService TvMaze

<PageTitle>TV Finder</PageTitle>

<h1>Airing Today</h1>

@if (errorMessage != null)
{
    <div class ="alert alert-danger">
        @errorMessage
    </div>
    
}
else if (schedule == null)
{
    <p>Loading...</p>
}
else if (schedule.Count == 0)
{
    <p>Nothing airing today.</p>
}
else
{
    <div class="row row-cols-2 row-cols-md-4 g-3">
        
        @foreach (var item in schedule)
        {
            <div class="col">
                <div class="card h-100">
                    @if(item.Show.Image?.Medium != null)
                    {
                        <img src="@item.Show.Image.Medium" class="card-img-top" alt="@item.Show.Name" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">"@item.Show.Name"</h5>
                        <p class="card-text">S@(item.Season) E@(item.Number) - @item.Name</p>
                        <p class="card-text"><small class="text-muted">@item.Airtime</small></p>
                    </div>
                </div>
            </div>
        }
    </div>
}
@code{
    private List<ScheduleItem>? schedule;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            schedule = await TvMaze.GetScheduleAsync();
        }
        catch
        {
            errorMessage = "Couldn't load today's schedule";
        }
    }



}