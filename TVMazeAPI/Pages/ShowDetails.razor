@page "/show/{Id:int}"
@inject TvMazeService TvMaze

<PageTitle>@(show?.Name ?? "Show details")</PageTitle>

<a href="" class="btn btn-link px-0 mb-3">← Back to search</a>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (notFound)
{
    <div class="alert alert-warning">Sorry, we couldn't find that show.</div>
}
else if (show == null)
{
    <p>Loading...</p>
}
else
{
    <div class="row g-4">
        <div class="col-md-4">
            @if (show.Image?.Original != null)
            {
                <img src="@show.Image.Original" class="img-fluid rounded shadow-sm" alt="@show.Name poster" />
            }
            else
            {
                <div class="bg-secondary-subtle rounded d-flex align-items-center justify-content-center"
                     style="aspect-ratio: 2 / 3;">
                    <span class="text-muted">No image</span>
                </div>
            }
        </div>

        <div class="col-md-8">
            <h1>@show.Name</h1>

            <p class="text-muted mb-2">
                @(show.Premiered?.Year.ToString() ?? "Unknown year")
                @if (show.Rating?.Average != null)
                {
                    <span class="badge bg-warning text-dark ms-2">★ @show.Rating.Average</span>
                }
            </p>

            @if (show.Genres.Count > 0)
            {
                <div class="mb-3">
                    @foreach (var genre in show.Genres)
                    {
                        <span class="badge bg-secondary me-1">@genre</span>
                    }
                </div>
            }

            @if (show.Summary != null)
            {
                <div>@((MarkupString)show.Summary)</div>
            }
            else
            {
                <p class="text-muted">No summary available.</p>
            }
        </div>
    </div>

    <h2 class="mt-5 mb-3">Cast</h2>
    @if (cast == null)
    {
        <p class="text-muted">Loading cast...</p>
    }
    else if (cast.Count == 0)
    {
        <p class="text-muted">No cast information available.</p>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
            @foreach (var member in showAllCast ? cast : cast.Take(12))
            {
                <div class="col">
                    <div class="card h-100 text-center">
                        @if (member.Person.Image?.Medium != null)
                        {
                            <img src="@member.Person.Image.Medium" class="card-img-top" alt="@member.Person.Name" />
                        }
                        else
                        {
                            <div class="bg-secondary-subtle d-flex align-items-center justify-content-center"
                                 style="aspect-ratio: 3 / 4;">
                                <span class="text-muted small">No photo</span>
                            </div>
                        }
                        <div class="card-body p-2">
                            <div class="fw-semibold small">@member.Person.Name</div>
                            <div class="text-muted small">as @member.Character.Name</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (cast.Count > 12)
        {
            <button type="button" class="btn btn-outline-secondary mt-3" @onclick="() => showAllCast = !showAllCast">
                @(showAllCast ? "Show less" : $"Show all {cast.Count} cast members")
            </button>
        }
    }

    <h2 class="mt-5 mb-3">Episodes</h2>

    @if (episodes == null)
    {
        <p class="text-muted">Loading episodes...</p>

    }
    else if (episodes.Count == 0)
    {
        <p class="text-muted">No episode information available.</p>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var season in Seasons)
            {
                <button type="button" class="btn btn-sm @(season == selectedSeason ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => selectedSeason = season">
                    Season @season
                </button>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>Air date</th>
                        <th>Runtime</th>
                        <th>Rating</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var episode in SelectedSeasonEpisodes)
                    {
                        <tr>
                            <td>@(episode.Number?.ToString() ?? "Special")</td>
                            <td>@episode.Name</td>
                            <td>@(string.IsNullOrEmpty(episode.AirDate) ? "TBA" : episode.AirDate)</td>
                            <td>@(episode.Runtime != null ? $"{episode.Runtime} min" : "–")</td>
                            <td>@(episode.Rating?.Average?.ToString() ?? "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Show? show;
    private bool notFound;
    private string? errorMessage;
    private List<CastMember>? cast;
    private bool showAllCast;

    private List<Episode>? episodes;
    private int selectedSeason;
    private List<int> Seasons
    {
        get
        {
            return episodes?.Select(e => e.Season).Distinct().Order().ToList() ?? new();
        }
    } 

    private List<Episode> SelectedSeasonEpisodes
    {
        get
        {
            return episodes?.Where(e => e.Season == selectedSeason).ToList() ?? new();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        show = null;
        notFound = false;
        errorMessage = null;
        cast = null;
        showAllCast = false;
        episodes = null;
        selectedSeason = 0;

        try
        {
            var showTask = TvMaze.GetShowAsync(Id);
            var castTask = TvMaze.GetCastAsync(Id);
            var episodesTask = TvMaze.GetEpisodesAsync(Id);

            show = await showTask;
            StateHasChanged();
            cast = await castTask;
            StateHasChanged();
            episodes = await episodesTask;

            selectedSeason = Seasons.FirstOrDefault();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            notFound = true;
        }
        catch
        {
            errorMessage = "Couldn't load this show.";
        }
    }

}